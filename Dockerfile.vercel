FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY . .
RUN dotnet restore src/Api/ConstructionManagement.Api.csproj
RUN dotnet publish src/Api/ConstructionManagement.Api.csproj \
    --configuration Release \
    --no-restore \
    --output /app/publish \
    --property:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app

COPY --from=build /app/publish .

ENV ASPNETCORE_ENVIRONMENT=Production
EXPOSE 3000

ENTRYPOINT ["sh", "-c", "dotnet ConstructionManagement.Api.dll --urls http://+:${PORT:-3000}"]
