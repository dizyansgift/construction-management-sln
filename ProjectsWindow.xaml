<Window x:Class="ConstructionManagement.ProjectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Projects | Fieldline" Width="980" Height="600"
        MinWidth="760" MinHeight="420" WindowStartupLocation="CenterOwner"
        Background="#F5F7F3">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#1C2927" />
        <SolidColorBrush x:Key="Muted" Color="#71807A" />
        <SolidColorBrush x:Key="Green" Color="#2D765B" />
    </Window.Resources>
    <DockPanel Margin="30">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,22">
            <TextBlock Text="PORTFOLIO" Foreground="#7F9A89" FontSize="10" FontWeight="Bold" />
            <TextBlock Text="Projects" Foreground="{StaticResource Ink}" FontSize="28" FontWeight="Bold" Margin="0,7,0,4" />
            <TextBlock Text="Your active construction projects and current financial position." Foreground="{StaticResource Muted}" FontSize="12" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <TextBlock x:Name="ProjectCountText" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" />
            <Button Content="Close" Padding="18,9" Margin="18,0,0,0" Click="Close_Click" />
        </StackPanel>
        <ListView x:Name="ProjectsList" BorderBrush="#E2E8E2" Background="White">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="PROJECT" DisplayMemberBinding="{Binding Name}" Width="210" />
                    <GridViewColumn Header="CUSTOMER" DisplayMemberBinding="{Binding Customer}" Width="145" />
                    <GridViewColumn Header="LOCATION" DisplayMemberBinding="{Binding Location}" Width="130" />
                    <GridViewColumn Header="BUDGET" DisplayMemberBinding="{Binding EstimatedBudget, StringFormat={}{0:C0}}" Width="115" />
                    <GridViewColumn Header="ACTUAL COST" DisplayMemberBinding="{Binding ActualCost, StringFormat={}{0:C0}}" Width="115" />
                    <GridViewColumn Header="PROGRESS" DisplayMemberBinding="{Binding ProgressPercent, StringFormat={}{0}%}" Width="85" />
                    <GridViewColumn Header="STATUS" DisplayMemberBinding="{Binding Status}" Width="105" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
