<Window x:Class="ConstructionManagement.WorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fieldline workspace" Width="850" Height="540"
        MinWidth="650" MinHeight="400" WindowStartupLocation="CenterOwner"
        Background="#F5F7F3">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#1C2927" />
        <SolidColorBrush x:Key="Muted" Color="#71807A" />
        <SolidColorBrush x:Key="Green" Color="#2D765B" />
    </Window.Resources>
    <DockPanel Margin="30">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,22">
            <TextBlock x:Name="EyebrowText" Foreground="#7F9A89" FontSize="10" FontWeight="Bold" />
            <TextBlock x:Name="TitleText" Foreground="{StaticResource Ink}" FontSize="28" FontWeight="Bold" Margin="0,7,0,4" />
            <TextBlock x:Name="SubtitleText" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Close" Padding="18,9" Click="Close_Click" />
        </StackPanel>
        <ListView x:Name="ItemsList" BorderBrush="#E2E8E2" Background="White" FontSize="12" Padding="10" />
    </DockPanel>
</Window>
